# =============================================================================
# CareerPilot AI — Environment Configuration Template
# =============================================================================

# Project Details
PROJECT_NAME="CareerPilot AI"
API_V1_STR="/api/v1"

# Application Security
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# SQLite (instant local development):
DATABASE_URL="sqlite:///./careerpilot.db"
# PostgreSQL (production/docker-compose):
# DATABASE_URL="postgresql+psycopg2://careerpilot:careerpilot_password@localhost:5432/careerpilot_db"

# Official Anthropic Claude API Configuration
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-haiku-5-5"

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# Frontend URL (for CORS)
VITE_API_URL="http://127.0.0.1:8000"
